# 개발/로컬 전용 환경변수 모음. `.env.example` 위에 덧붙여서 사용한다.
#
# 사용 예:
#   cp .env.example .env
#   cat .env.dev.example >> .env
#
# 여기 모인 값들은 모두 APP_ENV=dev 에서만 의미를 가지며, prod 에서
# 비기본값으로 설정하면 기동이 거부된다 (테스트 변수가 운영 트래픽에
# 새는 사고를 차단하기 위함).

APP_ENV=dev

# === 헤더/정책 우회 =========================================================
# true 로 설정하면 사용자 4개 헤더(X-API-Key/X-Timestamp/X-Nonce/X-Signature)
# 검증을 건너뛴다. 로컬·데모 전용. SKIP_POLICY_FETCH 와 독립 동작.
SKIP_HEADER_VERIFICATION=false

# admin-backend 정책 조회를 생략하고 L1~L6 전체 레이어를 강제 실행한다.
SKIP_POLICY_FETCH=false

# SKIP_POLICY_FETCH=true 일 때 입력 가드레일에서 실행할 레이어를 CSV 로
# 지정한다. 기본값(L1~L6)은 기존 동작과 동일. 빈 문자열이면 입력 측
# 가드레일이 비어 모든 입력이 통과된다. 토큰은 대소문자 무시(`l1`==`L1`),
# 공백 허용. 비기본값은 APP_ENV=dev 에서만 허용.
SKIP_POLICY_FETCH_INPUT_LAYERS="L1,L2,L3,L4,L5,L6"
# 출력 측 — 빈 문자열이면 outbound 파이프라인 전체가 생략되어 LLM 응답이
# 그대로 통과된다 (출력 검사 없음). 비기본값 dev 가드는 INPUT 과 동일.
SKIP_POLICY_FETCH_OUTPUT_LAYERS="L1,L2,L3,L4,L5,L6"
# SKIP_POLICY_FETCH=true 일 때 ADMIN 의 l5Setting.model 과 같은 역할.
# 빈 문자열이면 기본 L5 모델 설정을 사용한다.
SKIP_POLICY_FETCH_L5_MODEL=""
# SKIP_POLICY_FETCH=true 일 때 ADMIN 의 l5Setting.threshold 와 같은 역할.
# 빈 값이면 기본 L5 threshold. 값은 0.0~1.0 범위만 허용.
SKIP_POLICY_FETCH_L5_THRESHOLD=

# === 관찰 모드 (데모/디버그용) ==============================================
# true 면 레이어가 BLOCK 을 내려도 파이프라인을 끝까지 진행하고 응답에
# guardrail_reports 로 판정 내역을 첨부한다. APP_ENV=dev 에서만 허용.
CONTINUE_ON_LAYER_FAILURE=false

# === Playground (/playground/) 기본 입력값 — 데모/로컬 전용 =================
# APP_ENV=dev 에서만 /v1/playground/defaults 응답에 노출되어 페이지
# 로딩 시 X-API-Key / HMAC SECRET 입력 칸이 자동 채워진다. prod 에서는
# 값이 있어도 응답에 빈 문자열이 실린다 (브라우저로 시크릿이 새지 않게).
# 실제 운영용 키/시크릿은 절대 넣지 말 것.
PLAYGROUND_DEFAULT_API_KEY=""
PLAYGROUND_DEFAULT_HMAC_SECRET=""
