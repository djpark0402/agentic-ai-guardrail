# prod 운영용 환경변수 모음. 신규 사용자는 이 파일 한 장만 봐도 충분하다.
# 개발/로컬 전용 토글(헤더/정책 우회, Playground 자동 채움 등)은
# `.env.dev.example` 을 참고해 `.env` 끝에 덧붙여 사용한다.

# === Solar (Upstage) — 필수 =================================================
LLM_BASE_URL="https://api.upstage.ai/v1"
LLM_MODEL=""
UPSTAGE_API_KEY=""

# === Admin Backend — 필수 ===================================================
ADMIN_BACKEND_URL="http://localhost:8001"
# admin-backend `/api/v1/gateway/verify` 호출 시 `X-API-Key` 헤더에
# 실리는 게이트웨이 키. 빈 값이면 헤더를 붙이지 않는다.
# (사용자의 X-API-Key 와는 별개 — 게이트웨이가 ADMIN 에 인증하는 키)
ADMIN_API_KEY=

# === 운영 옵션 ===============================================================
# 실행 환경. "dev" 또는 "prod" — 기본 "prod" (safe-by-default).
# dev 전용 토글은 `.env.dev.example` 참고.
APP_ENV=prod
# 사용자 요청 `X-Timestamp` 헤더와 서버 시각의 허용 오차(초). 기본 5분.
REQUEST_TIMESTAMP_SKEW_SEC=300

# === LLM 레이어 (정책 기반 useLlm=true 시 활성화) — 선택 ====================
# ADMIN 정책 응답의 `useLlm=true` 일 때 활성 레이어 전부를 OpenAI 호환
# LLM 판정으로 대체한다. 모델 이름은 정책의 `judgmentModel` 만 사용하며,
# 누락 시 fail-closed BLOCK. BASE_URL+API_KEY 는 짝으로 설정.
LLM_LAYER__BASE_URL=""
LLM_LAYER__API_KEY=""
LLM_LAYER__TIMEOUT_SECONDS=15

# === 추가 LLM 제공자 — 선택 =================================================
# OpenAI (미설정 시 OpenAI 모델 요청은 에러)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o"
# Ollama (로컬 LLM, API 키 불필요. ollama/모델명 형식으로 요청)
# OLLAMA_BASE_URL="http://localhost:11434/v1"
