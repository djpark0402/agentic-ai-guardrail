# Solar (Upstage)
LLM_BASE_URL="https://api.upstage.ai/v1"
LLM_MODEL=""
UPSTAGE_API_KEY=""

# OpenAI (optional - 미설정 시 OpenAI 모델 요청은 에러)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o"

# Ollama (optional - 로컬 LLM, API 키 불필요, ollama/모델명 형식으로 요청)
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# 공통
# 실행 환경. "dev" 또는 "prod" — 기본 "prod" (safe-by-default).
# 관찰 모드(CONTINUE_ON_LAYER_FAILURE=true)는 APP_ENV=dev 일 때만 허용된다.
APP_ENV=prod
ADMIN_BACKEND_URL="http://localhost:8001"
# admin-backend `/api/v1/gateway/verify` 호출 시 `X-API-Key` 헤더에 실리는 게이트웨이 키.
# 빈 값이면 헤더를 붙이지 않는다. (사용자의 X-API-Key 와는 별개 — 게이트웨이가 ADMIN 에 인증하는 키)
ADMIN_API_KEY=
# 사용자 요청 `X-Timestamp` 헤더와 서버 시각의 허용 오차(초). 기본 5분.
REQUEST_TIMESTAMP_SKEW_SEC=300
# true 로 설정하면 사용자 4개 헤더(X-API-Key/X-Timestamp/X-Nonce/X-Signature) 검증을 건너뛴다.
# 로컬·데모 전용. SKIP_POLICY_FETCH 와 독립 동작.
SKIP_HEADER_VERIFICATION=false
# admin-backend 정책 조회를 생략하고 L1~L6 전체 레이어를 강제 실행하려면 true로 설정
SKIP_POLICY_FETCH=false
# SKIP_POLICY_FETCH=true 일 때 입력 가드레일에서 실행할 레이어를 CSV 로
# 지정한다. 기본값(L1~L6 전체)은 기존 동작과 동일. 빈 문자열이면 입력
# 가드레일 활성 레이어가 없어 모든 입력이 통과된다. 토큰은 대소문자 무시
# (`l1`==`L1`) 와 공백 허용. APP_ENV=dev 가 아닌데 비기본값을 지정하면
# 기동 실패 (테스트용 변수가 prod 로 새지 않게 차단).
SKIP_POLICY_FETCH_INPUT_LAYERS="L1,L2,L3,L4,L5,L6"
# SKIP_POLICY_FETCH=true 일 때 출력 가드레일에서 실행할 레이어를 CSV 로
# 지정한다. 빈 문자열이면 outbound 파이프라인 전체가 생략되어 LLM 응답이
# 그대로 통과된다 (출력 검사 없음). dev 전용 가드는 INPUT 과 동일.
SKIP_POLICY_FETCH_OUTPUT_LAYERS="L1,L2,L3,L4,L5,L6"
# SKIP_POLICY_FETCH=true 일 때 ADMIN 의 l5Setting.model 과 같은 역할을 한다.
# 빈 문자열이면 기본 L5 모델 설정을 사용한다. APP_ENV=dev 가 아닌데
# 비기본값을 지정하면 기동 실패.
SKIP_POLICY_FETCH_L5_MODEL=""
# SKIP_POLICY_FETCH=true 일 때 ADMIN 의 l5Setting.threshold 와 같은 역할을 한다.
# 빈 값이면 기본 L5 threshold 를 사용한다. 값은 0.0~1.0 범위만 허용.
SKIP_POLICY_FETCH_L5_THRESHOLD=
# 데모용 관찰 모드: 레이어가 BLOCK을 내려도 파이프라인을 끝까지 진행하고
# 응답에 guardrail_reports 블록으로 판정 내역을 첨부하려면 true로 설정.
# APP_ENV=dev 일 때만 true 허용 — 그 외 환경에서는 기동이 실패한다.
CONTINUE_ON_LAYER_FAILURE=false

# LLM 레이어 대체 옵션 — 기본값은 빈 문자열(비활성)이며 기존
# core-secure-layer L1~L6 실행 경로가 그대로 사용된다.
# 예: "L1,L4,L6" 로 지정하면 해당 레이어만 OpenAI 호환 LLM 판정으로
# 대체한다. 대체 LLM 은 사용자 요청에 답하지 않고 PASS/BLOCK JSON만
# 반환해야 하며, 호출 실패/스키마 오류는 fail-closed BLOCK 처리된다.
LLM_LAYER_REPLACEMENT_LAYERS=""
# LLM_LAYER_REPLACEMENT_LAYERS 가 비어 있지 않을 때만 필수.
LLM_LAYER_BASE_URL=""
LLM_LAYER_API_KEY=""
LLM_LAYER_MODEL=""
LLM_LAYER_TIMEOUT_SECONDS=15

# Playground (/playground/) 기본 입력값 — 데모/로컬 전용.
# APP_ENV=dev 일 때만 /v1/playground/defaults 응답에 노출되어
# playground 페이지 로딩 시 X-API-Key / HMAC SECRET 입력 칸이
# 자동으로 채워진다. APP_ENV=prod 에서는 값이 있어도 응답에
# 빈 문자열이 실린다 (시크릿이 브라우저로 새지 않게 차단).
# 시크릿이므로 실제 운영용 키/시크릿은 절대 넣지 말 것.
PLAYGROUND_DEFAULT_API_KEY=""
PLAYGROUND_DEFAULT_HMAC_SECRET=""
